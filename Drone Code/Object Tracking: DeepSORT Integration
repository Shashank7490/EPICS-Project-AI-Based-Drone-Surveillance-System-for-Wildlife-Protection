from deep_sort_realtime.deepsort_tracker import DeepSort

tracker = DeepSort(max_age=30) # Keep track of ID for 30 frames after loss

def process_tracking(frame, detections):
    # detections: list of [[x, y, w, h], confidence, class_id]
    tracks = tracker.update_tracks(detections, frame=frame)

    for track in tracks:
        if not track.is_confirmed():
            continue
        track_id = track.track_id
        ltrb = track.to_ltrb() # Get bounding box
        
        # Log movement vector
        print(f"Tracking ID: {track_id} at {ltrb}")
